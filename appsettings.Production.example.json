{
  "Backup": {
    "SourcePath": "C:\\Data\\ToBackUp",
    "Destination": "backup-remote:backups",
    "RcloneExecutable": "C:\\Tools\\rclone\\rclone.exe",
    "RcloneConfigPath": "C:\\ProgramData\\Backuper\\rclone.conf",
    "PowerShellExecutable": "powershell.exe",
    "Transfers": 4,
    "B2UploadConcurrency": 8,
    "UploadBandwidthLimit": "1Mi",
    "DailyRunTime": "02:00",
    "CheckIntervalMinutes": 30,
    "AppDataDirectory": "%ProgramData%\\Backuper",
    "DatabasePath": "backuper.db",
    "LogDirectory": "Logs",
    "LogRetentionDays": 7
  },
  "Notifications": {
    "Enabled": true,
    "AppId": "Backuper",
    "UseToast": true,
    "QueueDirectory": "%ProgramData%\\Backuper\\Notifications"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
